{
  "name": "medsafe-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Research prototype UI for subareas A and B. Decision support only. Not medical advice.",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-ocr.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/copy-ocr.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "gen:types": "node scripts/gen-types.mjs",
    "e2e": "node scripts/e2e.mjs",
    "visual": "node scripts/visual-check.mjs",
    "a11y": "node scripts/a11y.mjs",
    "test": "node --test src/features/aakaash/ocr/*.test.ts src/features/aakaash/viz/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/eng": "1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
